<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate" Width="740" Height="790" MinWidth="650" MinHeight="710"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13" Foreground="#202B38" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#DFE4EA"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3187C2"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#667587"/><Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF3F7"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#145A83"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="46"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D8E0E7"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="7"/>
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#738294" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#D8E0E7" BorderThickness="1" CornerRadius="7" Margin="0,4,0,4" Padding="4" MinWidth="{TemplateBinding ActualWidth}">
              <ScrollViewer MaxHeight="330" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#408DBD"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#778393"/><Setter Property="FontSize" Value="12"/></Style>
  </Window.Resources>
  <Grid Margin="32,20,32,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <Border Width="39" Height="39" Background="#203B50" CornerRadius="10" VerticalAlignment="Center"><TextBlock Text="a" Foreground="White" FontFamily="Segoe UI" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
        <StackPanel Margin="13,0,0,0"><TextBlock Text="Activate" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="JetBrains 产品配置" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <TextBlock Name="EnvironmentLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Text="本地工具" Foreground="#8893A0" FontSize="12"/>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E4E8ED" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,19,26,18">
          <Grid Margin="0,0,0,9"><TextBlock Text="选择产品" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="LocateButton" Content="定位安装" Style="{StaticResource TextButton}"/><Button Name="RefreshButton" Content="刷新" Style="{StaticResource TextButton}"/></StackPanel>
          </Grid>
          <ComboBox Name="ProductBox" AutomationProperties.Name="选择产品"/>
          <Grid Margin="0,19,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="当前软件版本" Style="{StaticResource Label}"/><TextBlock Name="VersionText" Text="检测中…" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
              <TextBlock Name="VersionDetail" Text="读取本机产品信息" Style="{StaticResource Label}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border Name="StatusBadge" Grid.Column="1" CornerRadius="11" Background="#F0F3F6" Padding="10,5" VerticalAlignment="Top" Margin="18,29,0,0"><TextBlock Name="StatusText" Text="正在检测" FontSize="11" Foreground="#667587"/></Border>
          </Grid>
          <Border Height="1" Background="#EDF0F3"/>
          <TextBlock Text="激活信息" FontWeight="SemiBold" Margin="0,16,0,13"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="配置检查" Style="{StaticResource Label}" Margin="0,0,0,13"/><TextBlock Name="ConfigText" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,13"/>
            <TextBlock Text="许可文件" Grid.Row="1" Style="{StaticResource Label}" Margin="0,0,0,13"/><TextBlock Name="LicenseText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,13"/>
            <TextBlock Text="文件声明日期" Grid.Row="2" Style="{StaticResource Label}" Margin="0,0,0,13"/><TextBlock Name="LicenseDateText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,0,0,13"/>
            <TextBlock Text="授权状态" Grid.Row="3" Style="{StaticResource Label}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="需在 IDE 中确认" Foreground="#778393"/>
          </Grid>
          <TextBlock Name="LicenseDetail" FontSize="11" Foreground="#97A0AC" Margin="0,13,0,0" TextWrapping="Wrap" Text="许可日期来自文件内容，未进行授权验签。"/>
          <Border Background="#F7F8FA" CornerRadius="7" Margin="0,15,0,0" Padding="13,11">
            <StackPanel><TextBlock Name="TargetText" Text="正在检测配置目录…" Foreground="#526171" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="沿用原脚本覆盖启动配置；执行前自动备份。" Foreground="#87919D" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <ProgressBar Name="Progress" Height="3" Margin="0,18,0,0" Visibility="Collapsed" Foreground="#3E7B9C" BorderThickness="0"/>
          <TextBlock Name="MessageText" Text="选择产品后开始。" Foreground="#667587" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="ActivateButton" Content="开始激活" Background="#203B50" BorderBrush="#203B50" Foreground="White" FontWeight="SemiBold" Height="43"/>
            <Button Name="RestoreButton" Grid.Column="1" Content="恢复上次配置" Height="43" Margin="10,0,0,0"/>
          </Grid>
          <Expander Name="LogExpander" Header="操作记录" Margin="0,12,0,0" Foreground="#778393" FontSize="12">
            <StackPanel Margin="0,10,0,0"><TextBox Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="135" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Background="#F7F8FA" BorderThickness="0" Padding="9"/>
              <Button Name="OpenDataButton" Content="打开备份与日志目录" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="1,15,1,0"><TextBlock Text="v1.0.0" FontFamily="Segoe UI" Foreground="#929BA7" FontSize="11"/><TextBlock Text="临时解包 · 完成后清理" HorizontalAlignment="Right" Foreground="#929BA7" FontSize="11"/></Grid>
  </Grid>
</Window>
